# TradeXLabel Server Configuration

# Database — PostgreSQL is now the default. Start it with:
#   docker compose up -d postgres
# Then push the schema with:
#   cd packages/server && npx prisma db push
DATABASE_URL="postgresql://tradexlabel:tradexlabel_dev@localhost:5432/tradexlabel"
# For offline dev without Docker, run scripts/use-sqlite.sh and use:
# DATABASE_URL="file:./dev.db"

# Redis (for pub/sub, caching, rate limiting)
REDIS_URL="redis://localhost:6379"

# JWT Secrets (minimum 32 characters in production)
JWT_SECRET="change-this-to-a-secure-random-string"
JWT_REFRESH_SECRET="change-this-to-another-secure-string"

# Server
PORT=6500
HOST=0.0.0.0
NODE_ENV=development

# Price Feed API Keys (optional — free sources are used by default)
# Crypto: Binance WebSocket (free, no key needed) is always active
# Forex/Indices/Commodities: Yahoo Finance (free, no key needed) is the default

# Finnhub — Premium forex real-time (free key at https://finnhub.io/register)
FINNHUB_API_KEY=""

# Twelve Data — Indices & Commodities (free key at https://twelvedata.com)
TWELVEDATA_API_KEY=""

# KYC Bridge — connects to the KYC verification app
KYC_API_URL="http://localhost:3000"
KYC_API_KEY=""

# Sprint 2.2: CORS — comma-separated list of allowed origins.
# Use "*" for dev (allows any origin). In production set explicit domains.
# Example: CORS_ALLOWED_ORIGINS="https://app.broker.com,https://dealer.broker.com"
CORS_ALLOWED_ORIGINS="*"

# Sprint 2.4: encryption key for sensitive DB columns (smtp_pass, api_key).
# Generate with: openssl rand -hex 32
# REQUIRED in production. The server refuses to start without it (fail-fast).
# If empty in dev, secrets stored as plaintext (logged warning).
ENCRYPTION_KEY=""

# Sprint 4.5: bearer token for /metrics endpoint. Empty = open in dev, 401 in prod.
# Generate with: openssl rand -hex 24
METRICS_AUTH_TOKEN=""

# Phase 2.2: Stripe billing for broker plans (optional). Without a key the
# billing pages show "not enabled" and the superadmin marks invoices paid.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Days a subscription may stay PAST_DUE before the tenant is suspended
BILLING_GRACE_DAYS=7
