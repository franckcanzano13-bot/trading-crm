# TradeXLabel Server Configuration

# Database
DATABASE_URL="file:./dev.db"
# For production with PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/tradexlabel"

# Redis (for pub/sub, caching, rate limiting)
REDIS_URL="redis://localhost:6379"

# JWT Secrets (minimum 32 characters in production)
JWT_SECRET="change-this-to-a-secure-random-string"
JWT_REFRESH_SECRET="change-this-to-another-secure-string"

# Server
PORT=6500
HOST=0.0.0.0
NODE_ENV=development

# Price Feed API Keys (optional — free sources are used by default)
# Crypto: Binance WebSocket (free, no key needed) is always active
# Forex/Indices/Commodities: Yahoo Finance (free, no key needed) is the default

# Finnhub — Premium forex real-time (free key at https://finnhub.io/register)
FINNHUB_API_KEY=""

# Twelve Data — Indices & Commodities (free key at https://twelvedata.com)
TWELVEDATA_API_KEY=""

# KYC Bridge — connects to the KYC verification app
KYC_API_URL="http://localhost:3000"
KYC_API_KEY=""

# Sprint 2.2: CORS — comma-separated list of allowed origins.
# Use "*" for dev (allows any origin). In production set explicit domains.
# Example: CORS_ALLOWED_ORIGINS="https://app.broker.com,https://dealer.broker.com"
CORS_ALLOWED_ORIGINS="*"

# Sprint 2.4: encryption key for sensitive DB columns (smtp_pass, api_key).
# Generate with: openssl rand -hex 32
# Required in production. If empty in dev, secrets stored as plaintext (legacy).
ENCRYPTION_KEY=""
