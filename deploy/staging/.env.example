# Phase 0.4 — Staging environment. Copy to .env on the host, fill every
# value, chmod 600. Never commit the filled file.

# Images (GHCR). IMAGE_TAG is overridden by deploy.sh / the deploy workflow.
IMAGE_BASE=ghcr.io/franckcanzano13-bot/trading-crm
IMAGE_TAG=main

# DNS: A records for ${STAGING_DOMAIN} and api.${STAGING_DOMAIN} → this host.
STAGING_DOMAIN=staging.tradexlabel.com
ACME_EMAIL=ops@tradexlabel.com

# Database (container-local for staging; managed service in production)
POSTGRES_USER=tradexlabel
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_DB=tradexlabel

# Secrets — generate each one:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars
METRICS_AUTH_TOKEN=CHANGE_ME

# Dealer module: 0 for a regulated demo, 1 to showcase the dealing desk.
ENABLE_DEALER_MODULE=1

# Price feeds (optional; free sources + mock fallback otherwise)
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=

# KYC bridge (optional)
KYC_API_URL=
KYC_API_KEY=

# Filled by deploy.sh after the first seed (used by the post-deploy smoke test)
SMOKE_TENANT_ID=
SMOKE_OTHER_TENANT_ID=

# Phase 1.7 — Monitoring (Grafana at https://grafana.<STAGING_DOMAIN>)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Where Alertmanager posts alerts (Slack incoming webhook, PagerDuty, ...)
ALERT_WEBHOOK_URL=

# Phase 1.6 — Backups (daily pg_dump sidecar). Copy the folder off-host!
BACKUP_DIR=/var/backups/tradexlabel
BACKUP_KEEP_DAYS=30
# Optional off-host copy with rclone (remote must be configured on the host); empty = local only
RCLONE_REMOTE=
