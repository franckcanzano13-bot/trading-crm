{
  "name": "tradexlabel",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run dev -w packages/server",
    "dev:web": "npm run dev -w packages/web",
    "build": "npm run build -w packages/shared && npm run build -w packages/server && npm run build -w packages/web",
    "test": "npm run test -w packages/server",
    "test:server": "npm run test -w packages/server",
    "test:web": "npm run test -w packages/web",
    "seed": "npm run seed -w packages/server",
    "lint": "eslint packages/*/src/**/*.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^8.2.2",
    "playwright": "^1.58.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "decimal.js": "^10.6.0"
  }
}
